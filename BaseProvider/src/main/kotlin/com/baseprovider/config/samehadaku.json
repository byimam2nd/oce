{
  "id": "Samehadaku",
  "name": "Samehadaku",
  "mainUrl": "https://v2.samehadaku.how",
  "lang": "id",
  "supportedTypes": ["Anime", "AnimeMovie", "OVA"],
  "searchPathPattern": "{baseUrl}/?s={query}",
  "tvPathSegment": "/anime/",
  "reverseEpisodes": true,
  "isHorizontal": true,
  "globalHeaders": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept-Language": "id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7"
  },
  "mainPageLists": [
    ["anime-terbaru/page/", "Anime Terbaru"],
    ["genre/action/page/", "Action"],
    ["genre/adventure/page/", "Adventure"],
    ["genre/comedy/page/", "Comedy"],
    ["genre/drama/page/", "Drama"],
    ["genre/fantasy/page/", "Fantasy"],
    ["genre/horror/page/", "Horror"],
    ["genre/isekai/page/", "Isekai"],
    ["genre/romance/page/", "Romance"],
    ["genre/sci-fi/page/", "Sci-Fi"],
    ["genre/slice-of-life/page/", "Slice of Life"]
  ],
  "searchItems": "div.animposx, .post-show li",
  "searchTitle": "h2, .entry-title a, .title",
  "searchHref": "a",
  "searchPoster": "div.animposx img, .content-thumb img, .thumb img",
  "searchRating": ".score, .rating, .rtng",
  "searchEpText": ".eps span, .epx, .bt span.epx",
  "loadTitle": "h1.entry-title, h1.title, .entry-title h1",
  "loadPoster": ".thumb img, div.thumb img, .ts-post-image",
  "loadDesc": "div.entry-content, div.desc, .description",
  "loadInfoBox": "div.spe",
  "loadTags": "div.spe a[rel=\"tag\"], div.genre-info a, .genres a",
  "loadStatus": "div.spe span:contains(Status), .spe",
  "loadTrailer": "iframe[src*=\"youtube\"], .trailer a",
  "loadRecommend": ".rand-animesu li, div.relat ul li, .relat article",
  "episodeItems": "div.lstepsiode ul li, .eplister li",
  "episodeHref": "a",
  "episodeTitle": ".lchx a, a, .epl-title",
  "episodeNum": ".eps a, .epl-num",
  "followLinkSelector": "#breadcrumbs a[href*=\"/anime/\"]",
  "ajaxPlayerUrl": "https://v2.samehadaku.how/wp-admin/admin-ajax.php",
  "selectorJsonData": ".east_player_option",
  "downloadItems": "div#downloadb li"
}