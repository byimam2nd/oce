    },
    {
      "step": "packedJs",
      "source": "response",
      "store": "decoded"
    },
    {
      "step": "regex",
      "pattern": "",
      "group": 1,
      "source": "decoded",
      "filter": "",
      "universal": true,
      "store": ""
    }
  ],
