{
  "id": "MegaPlay",
  "name": "MegaPlay",
  "mainUrl": "https://megaplay.buzz",
  "requiresReferer": false,
  "cached": true,
  "variants": [
    {
      "name": "default",
      "headers": {}
    }
  ],
  "steps": [
    {
      "step": "fetch",
      "url": "{url}",
      "referer": "",
      "headers": {},
      "store": "page"
    },
    {
      "step": "regex",
      "pattern": "data-id=\"([^\"]+)\"",
      "group": 1,
      "source": "page",
      "filter": "",
      "universal": false,
      "store": "playerId"
    },
    {
      "step": "constructUrl",
      "template": "{mainUrl}/stream/getSources?id={playerId}",
      "store": "apiUrl"
    },
    {
      "step": "fetch",
      "url": "{apiUrl}",
      "referer": "{mainUrl}",
      "headers": {},
      "store": "apiResponse"
    },
    {
      "step": "jsonPath",
      "path": "sources.file",
      "source": "apiResponse",
      "store": ""
    }
  ]
}