{
  "id": "CyberJunkiePage",
  "name": "CyberJunkiePage",
  "mainUrl": "https://cyber-junkie.com",
  "requiresReferer": true,
  "variants": [
    {
      "name": "default",
      "headers": {}
    }
  ],
  "steps": [
    {
      "step": "fetch",
      "url": "{url}",
      "referer": "",
      "headers": {},
      "store": "response"
    },
    {
      "step": "iframe",
      "comment": "Player tab ?player=N = pembungkus iframe ke embed host (gdplayer/dll). Ikuti iframe agar diextract extractor host tsb, bukan dead-end di wrapper page.",
      "source": "response",
      "selector": "iframe[src], video[src], source[src]",
      "attribute": "src",
      "exclude": "",
      "include": "",
      "base": "{url}"
    },
    {
      "step": "regex",
      "pattern": "",
      "group": 1,
      "source": "response",
      "filter": "",
      "universal": true,
      "store": ""
    },
    {
      "step": "webview",
      "url": "{url}",
      "referer": "",
      "headers": {},
      "interceptPattern": "(m3u8|mp4)",
      "timeoutMs": 20000
    }
  ],
  "videoReferer": "",
  "outputFilter": "none"
}